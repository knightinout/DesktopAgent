# AI Provider selection: "claude" (default) or "gemini"
# If omitted, the provider is auto-detected from which key is present.
AI_PROVIDER=claude

# Claude (Anthropic) API key — https://console.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key_here

# Gemini (Google) API key — https://aistudio.google.com/
# Set AI_PROVIDER=gemini above to use Gemini instead of Claude.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: folder monitored by the file organizer feature
WATCH_FOLDER=/path/to/your/watch/folder
